 return F}

// spec -> finished question (or null)
function finalize(m,need,ban){const M=buildMol(m);if(invalid(m,M))return null;
 if(m.kind=='chain'||(m.kind=='ester'&&m.ac.t=='chain')){const sb=stereoBonds(m,M);const tgt=m.kind=='chain'?m:m.ac;tgt.stereo={};
  sb.forEach(i=>tgt.stereo[i]=pick(['E','Z']))}
