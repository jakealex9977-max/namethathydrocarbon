function home(){stopT();S=null;let sh='';
 try{const q=new URLSearchParams(location.hash.slice(1));if(q.get('s')&&q.get('m'))sh=`<div class="note"><span>🏆 A friend scored <b>${(+q.get('s')).toLocaleString()}</b> in Practice (${+q.get('c')} correct, best streak ${+q.get('b')||0}). Can you beat it?</span><button class="pri" onclick="startGame()">Take the challenge</button></div>`}catch(e){}
 const seg=(o,cur,fn)=>`<div class="seg">${o.map(([v,t])=>`<button class="${cur==v?'on':''}" onclick="${fn}('${v}')">${t}</button>`).join('')}</div>`;
 const chk=CATS.map(([k,t])=>`<div class="cat2"${CATHELP[k]?` title="${esc(CATHELP[k])}"`:''}><b>${t}</b>${k=='nonum'?'<small class="mono">e.g. methylpropene</small>':''}<div class="seg">${[['0','Off'],['1','Allowed'],['2','Guaranteed']].map(([v,n])=>`<button class="${(CFG.cats[k]||0)==v?'on':''}" onclick="setCat('${k}',${v})">${n}</button>`).join('')}</div></div>`).join('');
 $.innerHTML=`<h1 class="hero">Name<small>that</small><mark>Hydrocarbon</mark></h1><p class="lede">Pick what you want to practice, then play. Questions never stop — your run ends when you run out of strikes.</p>${sh}
 <div class="card"><h3>Settings</h3>
