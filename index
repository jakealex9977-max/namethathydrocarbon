let RELAX=0;
function buildCats(){const D=CFG.diff||3,stt=k=>CFG.cats[k]||0,pr=[.2,.3,.4,.5,.6][D-1];
 let G=CATS.map(x=>x[0]).filter(k=>stt(k)==2),A=CATS.map(x=>x[0]).filter(k=>stt(k)==1);const dropped=[];
 for(const[a,b]of INCOMPAT)if(G.includes(a)&&G.includes(b)){G=G.filter(k=>k!=b);dropped.push(b)}
 for(let r=0;r<RELAX&&G.length;r++){const d=pick(G);G=G.filter(k=>k!=d);A.push(d);dropped.push(d)}
 const ban=CATS.map(x=>x[0]).filter(k=>stt(k)==0&&!dropped.includes(k)&&!(k=='dbl'&&G.includes('st')));
 for(let z=0;z<60;z++){const f={};G.forEach(k=>f[k]=true);
  const focus=G.length?null:(A.length?pick(A):null);A.forEach(k=>{if(k==focus||chance(pr))f[k]=true});
  for(const[a,b]of INCOMPAT)if(f[a]&&f[b])f[G.includes(a)?b:G.includes(b)?a:pick([a,b])]=false;
  if(f.st&&!f.est)f.dbl=true;if(f.st&&stt('dbl')==0&&!G.includes('st'))f.st=false;
  const small=f.nonum||(stt('nonum')>0&&chance(D<=2?.35:.2));
  if(small&&!G.includes('nonum')){const keep=['dbl','tri','hal','oh','sh','ket','ald','acid'].filter(k=>f[k]&&!G.includes(k));Object.keys(f).forEach(k=>{if(!G.includes(k))f[k]=false});if(keep.length)f[pick(keep)]=true}
  const spec=makeFrom(f,D,small);if(!spec)continue;
  const need=G.filter(k=>f[k]);if(small&&!need.includes('nonum'))need.push('nonum');
  const q=finalize(spec,need,ban);if(q){q.dropped=dropped.slice();return q}}
 return null}
function gen(){RELAX=0;const t0=Date.now();
 for(let k=0;k<4000&&Date.now()-t0<9000;k++){RELAX=Math.floor((Date.now()-t0)/1800);const q=buildCats();if(q){RELAX=0;return q}}
 RELAX=0;for(let k=0;k<200;k++){const q=finalize(genChain({},2),[],[]);if(q)return q}
