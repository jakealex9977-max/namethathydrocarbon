 <div class="ctl"><b>Difficulty</b><div class="seg">${[['1','Easy · 1–2 steps'],['2','Medium · 3–4'],['3','Hard · 5–7']].map(([v,n])=>`<button class="${(CFGR.d||1)==v?'on':''}" onclick="setRxnD(${v})">${n}</button>`).join('')}</div></div>
