</style></head><body><div id="app"></div><button id="thm" onclick="toggleTheme()" title="Toggle light / dark mode" aria-label="Toggle light or dark mode"></button>
<script>
/* ===================== Name That Hydrocarbon v4 — core ===================== */
const ST=['','meth','eth','prop','but','pent','hex','hept','oct','non','dec'],MU=['','','di','tri','tetra','penta','hexa'];
const HALS=['F','Cl','Br'],HN={F:'fluoro',Cl:'chloro',Br:'bromo'};
const R=(a,b)=>a+Math.floor(Math.random()*(b-a+1)),pick=a=>a[R(0,a.length-1)],chance=p=>Math.random()<p;
const asc=(a,b)=>a-b;
const cmp=(a,b)=>{if(Array.isArray(a)){for(let i=0;i<Math.max(a.length,b.length);i++){if(a[i]===undefined)return -1;if(b[i]===undefined)return 1;const c=cmp(a[i],b[i]);if(c)return c}return 0}return a<b?-1:a>b?1:0};
const nzs=s=>String(s||'').toLowerCase().replace(/\s+/g,'').replace(/[‐-―−]/g,'-');
// alphabetical key of a branch name: ignore anything in brackets and leading locants / multipliers
const ak=t=>{let s=t;while(/\([^()]*\)/.test(s))s=s.replace(/\([^()]*\)-?/g,'');return s.replace(/^[\d,\-]+/,'').replace(/-/g,'')};
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');

/* ---------- molecular graph ---------- */
class Mol{
 constructor(){this.at=[];this.bd=[];this.adj=[];this.rings=[]}
 add(el,o={}){const i=this.at.length;this.at.push({el,...o});this.adj.push([]);return i}
 bond(a,b,o=1){this.bd.push([a,b,o]);this.adj[a].push([b,o]);this.adj[b].push([a,o])}
 ord(a,b){const x=this.adj[a].find(q=>q[0]==b);return x?x[1]:0}
 el(i){return this.at[i].el}
 val(i){return this.adj[i].reduce((s,q)=>s+q[1],0)}
 hc(i){const a=this.at[i];if(a.ar)return this.adj[i].length==2?1:0;return({C:4,N:3,O:2,S:2,F:1,Cl:1,Br:1}[a.el])-this.val(i)}
 inRing(i){return this.rings.some(r=>r.ids.includes(i))}
}

// canonical string of the subtree hanging from i (coming from `from`)
function canon(M,i,from,seen){seen=new Set(seen||[]);seen.add(i);
 const k=M.adj[i].filter(([j])=>j!=from).map(([j,o])=>o+(seen.has(j)?'*'+M.el(j):canon(M,j,i,seen))).sort();
 return M.el(i)+(M.at[i].ar?'a':'')+'('+k.join(',')+')'}
function canonMol(M){let best=null;for(let i=0;i<M.at.length;i++){const c=canon(M,i,-1);if(best===null||c<best)best=c}return best}
// signature of a path (everything hanging off it + bond orders), direction-independent
function pathSig(M,p){const set=new Set(p);
 const one=q=>q.map((id,i)=>M.adj[id].filter(([j])=>!set.has(j)).map(([j,o])=>o+canon(M,j,id,set)).sort().join(',')+'|'+(i<q.length-1?M.ord(id,q[i+1]):0)).join('#');
 const a=one(p),b=one(p.slice().reverse());return a<b?a:b}
// all simple paths through acyclic carbons
function carbonPaths(M,ok){const out=[],ids=M.at.map((_,i)=>i).filter(ok);
 const dfs=(path,vis)=>{const last=path[path.length-1];let ext=false;
  for(const[j]of M.adj[last])if(!vis.has(j)&&ok(j)){ext=true;vis.add(j);path.push(j);dfs(path,vis);path.pop();vis.delete(j)}
  if(!ext)out.push(path.slice())};
 for(const s of ids){const deg=M.adj[s].filter(([j])=>ok(j)).length;if(deg<=1)dfs([s],new Set([s]))}
 return out}

/* ---------- substituents (branches) ----------
 hal {k:'hal',x}  oh {k:'oh'}  sh {k:'sh'}
 alk {k:'alk',n,a,ms:[{q,s}]}     chain of n carbons attached at carbon a, branches on carbon q
 cyc {k:'cyc',r,ar,ene:[j],ms:[{q,s}]}  ring attached at ring atom 0 (bond j joins atoms j and j+1)
 eth {k:'eth',n,ms:[{q,s}]}       -O- then n carbons                                        */
function prefixStr(items,noLoc){const g=new Map();
 items.forEach(it=>{if(!g.has(it.name))g.set(it.name,[]);g.get(it.name).push(it.loc)});
 return[...g.keys()].sort((a,b)=>cmp([ak(a),a],[ak(b),b])).map(nm=>{const L=g.get(nm).sort(asc);return(noLoc?'':L.join(',')+'-')+MU[L.length]+nm}).join('-')}
const bracketed=pre=>pre?'('+pre+')-':'';
function ringLoc(r,dir,q){return dir>0?q+1:((r-q)%r)+1}
function ringBondLoc(r,l1,l2){return Math.abs(l1-l2)==1?Math.min(l1,l2):Math.max(l1,l2)}
function subName(s){
 if(s.k=='hal')return HN[s.x];
 if(s.k=='nh2')return'amino';
 if(s.k=='oh')return'hydroxyl';
 if(s.k=='sh')return'sulfanyl';
 if(s.k=='alk'){const n=s.n,ms=s.ms||[];
  const c=[0,1].map(rv=>{const a2=rv?n+1-s.a:s.a,it=ms.map(m=>({loc:rv?n+1-m.q:m.q,name:subName(m.s)}));
   return{a2,it,key:[a2,it.map(x=>x.loc).sort(asc),it.slice().sort((x,y)=>cmp([ak(x.name),x.loc],[ak(y.name),y.loc])).map(x=>x.loc)]}}).sort((x,y)=>cmp(x.key,y.key))[0];
  return bracketed(prefixStr(c.it,n==1))+(c.a2==1?ST[n]+'yl':ST[n]+'-'+c.a2+'-yl')}
 if(s.k=='cyc'){const r=s.ar?6:s.r,ms=s.ms||[],ene=s.ene||[];
  const c=[1,-1].map(d=>{const L=q=>ringLoc(r,d,q),it=ms.map(m=>({loc:L(m.q),name:subName(m.s)})),el=ene.map(j=>ringBondLoc(r,L(j),L((j+1)%r))).sort(asc);
   return{it,el,key:[it.filter(x=>x.name=='hydroxyl').map(x=>x.loc).sort(asc),el,it.map(x=>x.loc).sort(asc),it.slice().sort((x,y)=>cmp([ak(x.name),x.loc],[ak(y.name),y.loc])).map(x=>x.loc)]}}).sort((x,y)=>cmp(x.key,y.key))[0];
  const base=s.ar?'phenyl':'cyclo'+ST[r]+(c.el.length?'-('+c.el.join(',')+'-'+MU[c.el.length]+'ene)-yl':'yl');
  return bracketed(prefixStr(c.it))+base}
 if(s.k=='eth'){const n=s.n,ms=s.ms||[],stem=ST[n],fg=ms.filter(m=>m.s.k=='oh'||m.s.k=='sh'),hl=ms.filter(m=>m.s.k=='hal');
  if(fg.length)return stem+'-('+(n==1?'':fg[0].q+'-')+(fg[0].s.k=='oh'?'ol':'thiol')+')-oxy';
  if(hl.length)return'('+prefixStr(hl.map(m=>({loc:m.q,name:subName(m.s)})),n==1)+')-'+stem+'oxy';
  return stem+'oxy'}
 throw new Error('sub '+s.k)}
const simpleSub=s=>s.k=='hal'||s.k=='oh'||s.k=='nh2'||(s.k=='alk'&&s.a==1&&!(s.ms||[]).length);
const isNested=s=>(s.k=='alk'&&((s.ms||[]).length||(s.a!=1&&s.a!=s.n)))||(s.k=='cyc'&&(s.ms||[]).length)||(s.k=='eth'&&(s.ms||[]).length);
// longest carbon reach of a branch measured from (and including) its attachment carbon
function subReach(s){if(s.k=='alk'){let m=Math.max(s.a,s.n-s.a+1);(s.ms||[]).forEach(x=>{if(x.s.k=='alk')m=Math.max(m,Math.abs(x.q-s.a)+1+subReach(x.s))});return m}return 0}

// attach a branch to atom `at`; returns root atom id
function attachSub(M,at,s){
 if(s.k=='hal'){const x=M.add(s.x);M.bond(at,x);return x}
 if(s.k=='oh'){const o=M.add('O');M.bond(at,o);return o}
 if(s.k=='nh2'){const o=M.add('N');M.bond(at,o);return o}
 if(s.k=='sh'){const o=M.add('S');M.bond(at,o);return o}
 if(s.k=='alk'){const c=[null];for(let i=1;i<=s.n;i++){c.push(M.add('C'));if(i>1)M.bond(c[i-1],c[i])}M.bond(at,c[s.a]);(s.ms||[]).forEach(m=>attachSub(M,c[m.q],m.s));return c[s.a]}
 if(s.k=='cyc'){const r=s.ar?6:s.r,ids=[];for(let i=0;i<r;i++)ids.push(M.add('C',s.ar?{ar:1}:{}));
  for(let i=0;i<r;i++)M.bond(ids[i],ids[(i+1)%r],!s.ar&&(s.ene||[]).includes(i)?2:1);
  M.rings.push({ids,ar:!!s.ar});M.bond(at,ids[0]);(s.ms||[]).forEach(m=>attachSub(M,ids[m.q],m.s));return ids[0]}
 if(s.k=='eth'){const o=M.add('O');M.bond(at,o);const c=[null];for(let i=1;i<=s.n;i++){c.push(M.add('C'));M.bond(i==1?o:c[i-1],c[i])}(s.ms||[]).forEach(m=>attachSub(M,c[m.q],m.s));return o}
 throw new Error('attach '+s.k)}

/* ---------- nitrogen groups (Lesson 7) ----------
 A group on N (or the alkyl part of a primary "alkylamine") is named from the longest chain through the C–N carbon,
 numbered so the C–N carbon is lowest; chains with 3+ carbons carry that number (N-1-propyl, N-2-propyl, 2-propylamine).
 Branches of that group go in brackets in front of it: N-1-(2-chloro)propyl, 1-(2-methyl)butylamine.             */
const brk=pre=>pre?'('+pre+')':'';
function nGroup(s){
 if(s.k=='cyc'&&s.ar)return'phenyl';
 const n=s.n,ms=s.ms||[];
 const c=[0,1].map(rv=>{const a2=rv?n+1-s.a:s.a,it=ms.map(m=>({loc:rv?n+1-m.q:m.q,name:subName(m.s)}));
  return{a2,it,key:[a2,it.map(x=>x.loc).sort(asc),it.slice().sort((x,y)=>cmp([ak(x.name),x.loc],[ak(y.name),y.loc])).map(x=>x.loc)]}}).sort((x,y)=>cmp(x.key,y.key))[0];
 return(n>=3?c.a2+'-':'')+brk(prefixStr(c.it))+ST[n]+'yl'}
function nPrefix(ns){const names=ns.map(nGroup).sort((a,b)=>cmp([ak(a),a],[ak(b),b]));
 if(names.length==2&&names[0]==names[1])return'N,N-di'+names[0];
 return names.map(x=>'N-'+x).join('-')}
// longest carbon chain through the attachment carbon of a group (used to decide which group is the parent)
function groupLen(s){if(s.k=='cyc')return s.ar?6:s.r;return s.n}
/* ---------- spec -> graph ----------
 chain : {kind:'chain',n,bonds:{i:2|3},subs:[{p,s}],oh:[p],sh:[p],ket:[p],ald,acid,eth:{p,s}|null,stereo:{i:'E'|'Z'}}
 ring  : {kind:'ring',r,ar,ene:[j],subs:[{p,s}],oh:[p],sh:[p],ket:[p],cooh:p|null}   ring atoms p = 0..r-1
 ester : {kind:'ester',ac:{t:'chain',n,bonds,subs,stereo}|{t:'benz',subs},al:{t:'chain',n,a,ms}|{t:'ring',r,ene,ms}} */
function chainAtoms(M,n,bonds){const c=[null];for(let i=1;i<=n;i++){c.push(M.add('C'));if(i>1)M.bond(c[i-1],c[i],(bonds||{})[i-1]||1)}return c}
function buildMol(m){const M=new Mol();
 if(m.kind=='chain'){const c=chainAtoms(M,m.n,m.bonds);M.chain=c.slice(1);
  if(m.acid){const o=M.add('O');M.bond(c[1],o,2);const h=M.add('O');M.bond(c[1],h,1);M.grp=[c[1],o,h]}
  if(m.acid2){const o=M.add('O');M.bond(c[m.n],o,2);const h=M.add('O');M.bond(c[m.n],h,1)}
  if(m.ald){const o=M.add('O');M.bond(c[1],o,2)}
  (m.ket||[]).forEach(p=>{const o=M.add('O');M.bond(c[p],o,2)});
  (m.oh||[]).forEach(p=>attachSub(M,c[p],{k:'oh'}));(m.sh||[]).forEach(p=>attachSub(M,c[p],{k:'sh'}));
  (m.subs||[]).forEach(x=>attachSub(M,c[x.p],x.s));if(m.eth)attachSub(M,c[m.eth.p],m.eth.s);
  M.spine=M.chain;M.stype='chain';return M}
 if(m.kind=='ring'){const r=m.ar?6:m.r,ids=[];for(let i=0;i<r;i++)ids.push(M.add('C',m.ar?{ar:1}:{}));
  for(let i=0;i<r;i++)M.bond(ids[i],ids[(i+1)%r],!m.ar&&(m.ene||[]).includes(i)?2:1);M.rings.push({ids,ar:!!m.ar});
  (m.ket||[]).forEach(p=>{const o=M.add('O');M.bond(ids[p],o,2)});
  (m.oh||[]).forEach(p=>attachSub(M,ids[p],{k:'oh'}));(m.sh||[]).forEach(p=>attachSub(M,ids[p],{k:'sh'}));
  (m.subs||[]).forEach(x=>attachSub(M,ids[x.p],x.s));
  if(m.cooh!=null){const c=M.add('C');M.bond(ids[m.cooh],c);const o=M.add('O');M.bond(c,o,2);const h=M.add('O');M.bond(c,h,1)}
  M.ring=ids;M.spine=ids;M.stype='ring';return M}
 if(m.kind=='ester'){let carb,acidIds;
  if(m.ac.t=='chain'){const c=chainAtoms(M,m.ac.n,m.ac.bonds);acidIds=c.slice(1);carb=c[1];(m.ac.subs||[]).forEach(x=>attachSub(M,c[x.p],x.s));M.chain=acidIds;M.spine=acidIds;M.stype='chain'}
  else{const ids=[];for(let i=0;i<6;i++)ids.push(M.add('C',{ar:1}));for(let i=0;i<6;i++)M.bond(ids[i],ids[(i+1)%6]);M.rings.push({ids,ar:true});
   (m.ac.subs||[]).forEach(x=>attachSub(M,ids[x.p],x.s));carb=M.add('C');M.bond(ids[0],carb);acidIds=[carb,...ids];M.ring=ids;M.spine=ids;M.stype='ring'}
  const od=M.add('O');M.bond(carb,od,2);const oe=M.add('O');M.bond(carb,oe,1);
  const before=M.at.length;
  if(m.al.t=='chain')attachSub(M,oe,{k:'alk',n:m.al.n,a:m.al.a,ms:m.al.ms});else attachSub(M,oe,{k:'cyc',r:m.al.r,ene:m.al.ene,ms:m.al.ms});
  M.acidSide=new Set(acidIds);M.alcSide=new Set();for(let i=before;i<M.at.length;i++)M.alcSide.add(i);
  M.alcRoot=M.adj[oe].find(([j])=>j!=carb)[0];M.carb=carb;M.oe=oe;return M}
 if(m.kind=='amine'){let at;
  if(m.par.t=='chain'){const c=chainAtoms(M,m.par.n,{});M.chain=c.slice(1);M.spine=M.chain;M.stype='chain';at=c[m.par.a];(m.par.subs||[]).forEach(x=>attachSub(M,c[x.p],x.s))}
  else{const r=m.par.r,ids=[];for(let i=0;i<r;i++)ids.push(M.add('C'));for(let i=0;i<r;i++)M.bond(ids[i],ids[(i+1)%r]);M.rings.push({ids,ar:false});M.ring=ids;M.spine=ids;M.stype='ring';at=ids[0]}
  const N=M.add('N');M.bond(at,N);M.nAtom=N;M.nsub=nSubs(M,N,m.ns);return M}
 if(m.kind=='amide'){let carb;
  if(m.ac.t=='chain'){const c=chainAtoms(M,m.ac.n,{});carb=c[1];M.chain=c.slice(1);M.spine=M.chain;M.stype='chain';(m.ac.subs||[]).forEach(x=>attachSub(M,c[x.p],x.s));M.acidSide=new Set(M.chain)}
  else{const ids=[];for(let i=0;i<6;i++)ids.push(M.add('C',{ar:1}));for(let i=0;i<6;i++)M.bond(ids[i],ids[(i+1)%6]);M.rings.push({ids,ar:true});
   (m.ac.subs||[]).forEach(x=>attachSub(M,ids[x.p],x.s));carb=M.add('C');M.bond(ids[0],carb);M.ring=ids;M.spine=ids;M.stype='ring'}
  const o=M.add('O');M.bond(carb,o,2);const N=M.add('N');M.bond(carb,N);M.nAtom=N;M.carb=carb;M.nsub=nSubs(M,N,m.ns);return M}
 throw new Error('kind '+m.kind)}
// attach the groups on N and remember each group's atoms + its named chain (for the checks)
function nSubs(M,N,ns){return(ns||[]).map(s=>{const b=M.at.length,root=attachSub(M,N,s),atoms=new Set();for(let i=b;i<M.at.length;i++)atoms.add(i);
 const chain=s.k=='alk'?Array.from({length:s.n},(_,k)=>b+k):null;return{s,root,atoms,chain}})}

// stereogenic C=C bonds of the parent chain: both carbons inside the chain, and on each carbon the
// chain side differs from what else is attached (H or a branch). Reference group = the parent chain.
function stereoBonds(m,M){const out=[],ch=M.chain;if(!ch)return out;const n=ch.length;
 for(let i=2;i<=n-2;i++){if(M.ord(ch[i-1],ch[i])!=2)continue;let ok=true;
  for(const[me,rest,mate]of[[ch[i-1],ch[i-2],ch[i]],[ch[i],ch[i+1],ch[i-1]]]){
   const other=M.adj[me].filter(([j])=>j!=rest&&j!=mate);
   if(other.length&&canon(M,other[0][0],me)==canon(M,rest,me))ok=false}
  if(ok)out.push(i)}
 return out}

// returns null when the structure is a fair, unambiguous question; otherwise a reason
function invalid(m,M){
 for(let i=0;i<M.at.length;i++)if(M.hc(i)<0)return'valence';
 const acyc=i=>M.el(i)=='C'&&!M.inRing(i);
 const chk=(chain,req,within)=>{const n=chain.length,sg=pathSig(M,chain);
  for(const q of carbonPaths(M,i=>acyc(i)&&(!within||within.has(i)))){if(!req.every(x=>q.includes(x)))continue;
