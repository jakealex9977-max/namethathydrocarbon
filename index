function featuresOf(m,M){const F=new Set();
 M.bd.forEach(([a,b,o])=>{if(M.el(a)=='C'&&M.el(b)=='C'){if(o==2)F.add('dbl');if(o==3)F.add('tri')}});
 M.rings.forEach(r=>F.add(r.ar?'benz':(M.stype=='ring'&&r.ids===M.ring?'cyclo':'ring')));
 M.at.forEach(a=>{if(a.el=='N')F.add(m.kind=='amide'?'amide':'amine')});
 M.at.forEach((a,i)=>{if(a.el=='O'&&M.hc(i)==1&&!M.adj[i].some(([j])=>M.adj[j].some(([k,o])=>M.el(k)=='O'&&o==2)))F.add('oh');if(a.el=='S')F.add('sh');if(HALS.includes(a.el))F.add('hal')});
 if(m.kind=='chain'){if(m.eth)F.add('eth');if((m.ket||[]).length)F.add('ket');if(m.ald)F.add('ald');if(m.acid)F.add('acid');if(Object.keys(m.stereo||{}).length)F.add('st');
  if((m.subs||[]).some(x=>isNested(x.s))||(m.eth&&isNested(m.eth.s)))F.add('nest')}
 if(m.kind=='ring'){if((m.ket||[]).length)F.add('ket');if(m.cooh!=null)F.add('acid');if((m.subs||[]).some(x=>isNested(x.s)))F.add('nest')}
 if(m.kind=='ester'){F.add('est');if(m.ac.t=='chain'&&Object.keys(m.ac.stereo||{}).length)F.add('st');if((m.al.ms||[]).some(x=>x.s.k!='oh')||(m.al.t=='chain'&&m.al.a!=1&&m.al.a!=m.al.n))F.add('nest')}
 if(m.kind=='amine'||m.kind=='amide'){if(m.ns.some(g=>(g.ms||[]).length))F.add('nest');if(m.kind=='amide'&&(m.ac.subs||[]).some(x=>isNested(x.s)))F.add('nest')}
