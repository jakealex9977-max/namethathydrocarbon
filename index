 <p class="sub">${asked?'Avg '+fmt(S.sp.reduce((s,x)=>s+x.t,0)/asked)+' per question · ':''}Best streak: ${S.best} 🔥${getBest()>S.score?' · Personal best: '+getBest():S.score?' · New personal best!':''}</p>
 <div class="row"><button class="pri" onclick="startGame(S.mode)">▶ Play again</button><button id="cp" onclick="copyLink()">🔗 Copy link to share</button><button onclick="home()">Home</button></div></div>`}
function copyLink(){const b=document.getElementById('cp'),t=`I scored ${S.score} in Name That Hydrocarbon! Beat me: ${S.url}`,ok=()=>b.textContent='✅ Link copied!';
 const fb=()=>{const a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();try{document.execCommand('copy');ok()}catch(e){prompt('Copy this link:',t)}a.remove()};
 try{navigator.clipboard.writeText(t).then(ok,fb)}catch(e){fb()}}
