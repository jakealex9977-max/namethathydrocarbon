function rxDo(id){const X=S.rx,rx=RX.find(r=>r.id==id);X.pend=null;if(!X.sel.length){X.msg='Tap a molecule on your bench first.';return gameUI()}
 const A=X.bench[X.sel[0]],B=rx.two?X.bench[X.sel[1]!==undefined?X.sel[1]:X.sel[0]]:null;
 if(A.final||(B&&B.final)){X.msg='Esters and amides are finished products here — they don’t react further.';return gameUI()}
 if(!rx.two&&X.sel.length>1){X.msg='This reaction uses one molecule — tap to deselect the other.';return gameUI()}
 const prods=runRx(rx,A,B);if(!prods.length){X.msg=`Nothing happens: this needs ${rx.need}.`;return gameUI()}
 X.msg='';if(prods.length==1)return rxAdd(prods[0],rx,A,B);X.pend={prods,rx,A,B};gameUI()}
function rxPick(i){const p=S.rx.pend;rxAdd(p.prods[i],p.rx,p.A,p.B)}
function rxAdd(p,rx,A,B){const X=S.rx;X.pend=null;let k=X.bench.findIndex(b=>b.canon==p.canon);
 X.log.push(`${A.name}${B?' + '+B.name:''} → ${rx.grp.replace(/ \(.*\)/,'')}: ${rx.lab} → ${p.name}${rx.by?' (+ '+rx.by+')':''}`);
 if(k<0){X.bench.push(p);k=X.bench.length-1}X.sel=[k];
 if(p.canon==S.cur.target.canon){S.el=Date.now()-S.t0;stopT();S.at=Date.now();S.ans=true;S.pick=0;score(true)}gameUI()}
function rxUndo(){const X=S.rx;if(!X.log.length||S.ans)return;X.log.pop();if(X.bench.length>1)X.bench.pop();X.sel=[X.bench.length-1];X.pend=null;X.msg='';gameUI()}
function rxGiveUp(){if(S.ans)return;S.el=Date.now()-S.t0;stopT();S.at=Date.now();S.ans=true;S.pick=0;score(false);gameUI()}
function gradeOpt(i){if(S.ans)return;S.el=Date.now()-S.t0;stopT();S.at=Date.now();S.ans=true;S.pick=i;score(!!S.cur.opts[i].ok);gameUI()}
document.addEventListener('keydown',e=>{if(e.key=='Enter'&&S&&!S.ans&&S.cur&&S.cur.build){e.preventDefault();gradeBuild();return}if(S&&!S.ans&&S.cur&&S.cur.opts&&/^[1-4]$/.test(e.key)&&+e.key<=S.cur.opts.length)gradeOpt(+e.key-1)});
const PM=['⏱️','🥉','🥉','🥈','🥇','🏆'];
function paceOf(){const a=S.sp;if(!a.length)return{tier:0,msg:'Baseline set — now beat it!',avg:0,pct:0};
 const avg=a.reduce((s,x)=>s+x.t,0)/a.length,r=S.el/avg,T=r<.4?[5,'Amazing pace!']:r<.6?[4,'Great pace!']:r<.8?[3,'Quick!']:r<1?[2,'Ahead of pace']:r<1.25?[1,'Right on pace']:[0,'Slower than usual'];
 return{tier:T[0],msg:T[1],avg,pct:Math.round((1-r)*100)}}
function paceHTML(){const p=S.pace;return`<div class="pace t${p.tier}"><span class="medal">${PM[p.tier]}</span><div><b>${p.msg}</b><small>${fmt(S.el)}${p.avg?` vs ${fmt(p.avg)} avg · ${p.pct>=0?p.pct+'% faster':-p.pct+'% slower'}`:' · first answer'}</small></div></div>`}
function fireworks(tier,msg){if(!tier||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
 if(tier>=4){const e=document.createElement('div');e.className='pacepop';e.textContent=msg;document.body.appendChild(e);setTimeout(()=>e.remove(),1800)}
 const cv=document.createElement('canvas'),dpr=Math.min(2,window.devicePixelRatio||1),W=innerWidth,H=innerHeight;
 cv.style.cssText='position:fixed;left:0;top:0;width:100%;height:100%;pointer-events:none;z-index:20';cv.width=W*dpr;cv.height=H*dpr;document.body.appendChild(cv);
 const g=cv.getContext('2d');g.scale(dpr,dpr);
 const COL={bronze:['#cd7f32','#e39a4f','#a8642a'],silver:['#d9dde3','#aeb6c2','#f4f6f8'],gold:['#ffd700','#ffc300','#fff1a8','#ffb000']};
 const mix=[0,['bronze'],['bronze','bronze','silver'],['bronze','silver','silver'],['silver','gold','gold'],['bronze','silver','gold','gold','gold']][tier],Pt=[],cx=W/2,cy=H*.38;
 const burst=(n,x,y)=>{for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,sp=(tier>=4?6:4)+Math.random()*(tier*2.2+3);Pt.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-3-tier*.5,r:2+Math.random()*(2+tier),c:pick(COL[pick(mix)]),life:70+Math.random()*50,rot:Math.random()*6,vr:(Math.random()-.5)*.4,star:tier>=4&&Math.random()<.35,tr:tier>=3&&Math.random()<.5})}};
 burst([0,26,44,70,110,170][tier],cx,cy);
 const star=(x,y,r)=>{g.beginPath();for(let k=0;k<10;k++){const rr=k%2?r*.45:r,a=k*Math.PI/5-Math.PI/2;g.lineTo(x+Math.cos(a)*rr,y+Math.sin(a)*rr)}g.closePath();g.fill()};
 let f=0;(function loop(){f++;g.clearRect(0,0,W,H);
  if(tier>=5&&f==16){burst(70,W*.25,H*.45);burst(70,W*.75,H*.45)}
  if(tier>=5&&f<14){g.fillStyle=`rgba(255,215,0,${.16*(1-f/14)})`;g.fillRect(0,0,W,H)}
  if(tier>=5&&f<40){g.strokeStyle=`rgba(255,215,0,${1-f/40})`;g.lineWidth=5;g.beginPath();g.arc(cx,cy,f*14,0,7);g.stroke()}
  let alive=0;for(const p of Pt){if(p.life<=0)continue;alive++;p.life--;p.vy+=.18;p.vx*=.985;p.x+=p.vx;p.y+=p.vy;p.rot+=p.vr;const al=Math.min(1,p.life/30);g.fillStyle=p.c;
   if(p.tr){g.globalAlpha=al*.35;g.beginPath();g.arc(p.x-p.vx*2,p.y-p.vy*2,p.r*.7,0,7);g.fill()}
   g.globalAlpha=al;if(p.star)star(p.x,p.y,p.r*1.8);else{g.save();g.translate(p.x,p.y);g.rotate(p.rot);g.fillRect(-p.r,-p.r*.6,p.r*2,p.r*1.2);g.restore()}}
  g.globalAlpha=1;if((alive||f<20)&&f<220)requestAnimationFrame(loop);else cv.remove()})()}
function splitsHTML(){const a=S.sp,c=a.filter(x=>x.ok),avg=a.length?a.reduce((s,x)=>s+x.t,0)/a.length:0,fast=c.length?Math.min(...c.map(x=>x.t)):0,bb=a.reduce((s,x)=>s+x.b,0);
 return`<div class="card splits"><div class="sphead"><h3>Splits</h3><div class="spstats"><span class="pill">Avg <b>${a.length?fmt(avg):'–'}</b></span><span class="pill">Fastest <b>${c.length?fmt(fast):'–'}</b></span><span class="pill">Speed bonus <b>+${bb}</b></span></div></div>${a.length?`<ol class="splist">${a.slice().reverse().map(x=>`<li class="${x.ok?'':'x'}"><span>Q${x.n}</span><i style="width:${Math.min(100,x.t/600)}%"></i><b>${fmt(x.t)}</b><em>${x.ok?(x.b?'+'+x.b+' ⚡':'—'):'✗'}</em></li>`).join('')}</ol>`:'<p class="mono">Your split times show up here after each answer.</p>'}</div>`}
function finish(){stopT();setBest(S.score);const asked=S.sp.length;
 const msg=S.right>=30?'Unstoppable!':S.right>=10?'Great run!':'Good start — go again!';
 S.url=location.href.split('#')[0]+'#'+new URLSearchParams({m:'inf',s:S.score,c:S.right,t:asked,b:S.best});
 $.innerHTML=`<div class="end card"><div class="trophy">🏆</div><h2 style="margin:4px 0">${msg}</h2><div class="sub">Practice</div>
