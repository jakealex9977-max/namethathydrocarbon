// a group on N: methyl/ethyl/propyl/butyl (attached at C1 or C2), branched with a methyl or halogen, or phenyl
function nSubGroup(f,D,maxLen){const o=[];for(let n=1;n<=Math.min(maxLen,D>=3?4:3);n++)o.push(n);const n=pick(o);
 if(f.benz&&chance(.35))return{k:'cyc',ar:1,r:6};
 if(n>=3&&f.nest&&chance(.6)){const ms=[{q:2,s:f.hal&&chance(.5)?hal():alk(1)}];return alk(n,1,ms)}
