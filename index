function genAmide(f,D){let ac;
 if(f.benz&&chance(.5)){const subs=[];for(let k=0;k<R(0,D>=3?2:1);k++){const p=R(1,5);if(!subs.some(x=>x.p==p))subs.push({p,s:f.hal&&chance(.5)?hal():alk(1)})}ac={t:'benz',subs}}
