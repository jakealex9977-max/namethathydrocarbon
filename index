 let par;if(f.cyclo){par={t:'ring',r:R(3,6)}}
 else{const n=R(f.benz?7:[2,3,4,5,6][D-1],Math.max(f.benz?8:[3,4,5,6,7][D-1],f.benz?8:2));par={t:'chain',n,a:R(1,Math.ceil(n/2)),subs:[]};
  const sp=[];for(let p=1;p<=n;p++)if(p!=par.a)sp.push(p);
  const nb=D>=2?R(f.ring||f.hal?1:0,Math.min(2,D-1)):0;for(let k=0;k<nb&&sp.length;k++){const p=sp.splice(R(0,sp.length-1),1)[0];
