  const ex=P[from][0]+Math.cos(e),ey=P[from][1]+Math.sin(e),cx=ex+Rr*Math.cos(e),cy=ey+Rr*Math.sin(e),k0=r.ids.indexOf(entry),sg=sgn();
  r.ids.forEach((id,idx)=>{const k=(idx-k0+n)%n,a=e+Math.PI+sg*2*Math.PI*k/n;put(id,cx+Rr*Math.cos(a),cy+Rr*Math.sin(a))});
