 if(f.acid)m.acid=1;else if(f.ald)m.ald=1;if(m.acid&&!small&&n>=3&&chance(.3))m.acid2=1;const fixed=m.acid||m.ald;
 const cap=[0],het=[],sp=new Set(),sp2=new Set();for(let p=1;p<=n;p++)cap.push(4-(p>1)-(p<n));
